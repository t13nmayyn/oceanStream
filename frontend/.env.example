# ── OceanStream Frontend Environment ────────────────────────────────────────
# Python FastAPI backend — used for snapshot, timeline, argo, date-info
VITE_PYTHON_API_URL=http://localhost:8000

# Node/Express gateway — used for point queries (validated & forwarded to Python)
VITE_NODE_API_URL=http://localhost:3001

# WebSocket stream (Python backend)
VITE_WS_URL=ws://localhost:8000/ws/ocean-stream
