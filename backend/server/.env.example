# ── Node Gateway ──────────────────────────────────────────
# Port this Express gateway listens on
PORT=3001

# URL of the existing Python FastAPI backend (no trailing slash)
PYTHON_API_URL=http://127.0.0.1:8000

# Upstream timeout in milliseconds (default: 10000)
UPSTREAM_TIMEOUT_MS=10000

# Gemini configuration (server-side only; never expose to React/Vite)
#
# Gemini rate limits are enforced at the project level.
# Multiple keys from the same project do not multiply project quota.
# Use separate project credentials only where legitimate failover is needed.
#
# Provide up to 5 failover keys:
GEMINI_KEY_1=
GEMINI_KEY_2=
# GEMINI_KEY_3=
# GEMINI_KEY_4=
# GEMINI_KEY_5=

# (Legacy fallback) Used if no GEMINI_KEY_N variables are provided
GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.8-flash
