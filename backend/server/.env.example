# ── Node Gateway ──────────────────────────────────────────
# Port this Express gateway listens on
PORT=3001

# URL of the existing Python FastAPI backend (no trailing slash)
PYTHON_API_URL=http://127.0.0.1:8000

# Upstream timeout in milliseconds (default: 10000)
UPSTREAM_TIMEOUT_MS=10000

# Gemini configuration (server-side only; never expose to React/Vite)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
